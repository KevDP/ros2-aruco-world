<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gyro_calibration</name>
  <version>0.1.0</version>
  <description>Measures the gyro's bias while the robot stands still after start-up and republishes the IMU with it taken out.</description>
  <maintainer email="58478385+KevDP@users.noreply.github.com">Kevin Delgado</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
