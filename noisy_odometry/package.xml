<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>noisy_odometry</name>
  <version>0.1.0</version>
  <description>Turns the simulation's exact wheel odometry into odometry that drifts like a real robot's, with random, zero-mean errors that grow with the distance travelled and the angle turned.</description>
  <maintainer email="58478385+KevDP@users.noreply.github.com">Kevin Delgado</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
