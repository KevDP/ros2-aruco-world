<?xml version="1.0"?>
<!--
  Generic differential drive robot with a forward-facing camera.

  Frame: X forward, Y left, Z up, origin on the floor under the wheel axle.
  Body 0.36 x 0.24 x 0.08 m, wheels 0.10 m in diameter, 0.28 m apart.
  Two frictionless spheres under the body, front and back, act as casters.
  The camera sits 0.25 m above the floor, looking straight ahead.
-->
<sdf version="1.9">
  <model name="camera_bot">

    <link name="base_link">
      <pose>0 0 0.09 0 0 0</pose>
      <inertial>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.0214</ixx><iyy>0.0453</iyy><izz>0.0624</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="body">
        <geometry><box><size>0.36 0.24 0.08</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.6 1</ambient>
          <diffuse>0.15 0.35 0.6 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry><box><size>0.36 0.24 0.08</size></box></geometry>
      </collision>
      <collision name="caster_front_collision">
        <pose>0.14 0 -0.065 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_front">
        <pose>0.14 0 -0.065 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="caster_back_collision">
        <pose>-0.14 0 -0.065 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_back">
        <pose>-0.14 0 -0.065 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="mast">
        <pose>0.15 0 0.09 0 0 0</pose>
        <geometry><box><size>0.03 0.03 0.10</size></box></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.14 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00022</ixx><iyy>0.00022</iyy><izz>0.000375</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="tire">
        <geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="tire_collision">
        <geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry>
      </collision>
    </link>

    <link name="right_wheel">
      <pose>0 -0.14 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00022</ixx><iyy>0.00022</iyy><izz>0.000375</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="tire">
        <geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="tire_collision">
        <geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry>
      </collision>
    </link>

    <link name="camera_link">
      <pose>0.17 0 0.25 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="camera">
        <geometry><box><size>0.03 0.08 0.03</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>/camera/image</topic>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20</far>
          </clip>
          <camera_info_topic>/camera/camera_info</camera_info_topic>
        </camera>
      </sensor>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.28</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.6</max_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
  </model>
</sdf>
