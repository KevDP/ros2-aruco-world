Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 300
  - Class: rviz_common/Views
    Name: Views
    Expanded:
      - /Current View1
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Alpha: 1
      Collision Enabled: false
      Description Source: Topic
      # robot_state_publisher latches the description (transient local), so a late RViz still gets it.
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Name: Frames
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.4
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Detections
      Enabled: true
      Topic:
        Value: /aruco/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Marker map
      Enabled: true
      # Latched by the localizer (transient local), so a late RViz still gets it.
      Topic:
        Value: /aruco/marker_map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot from markers
      Enabled: true
      Topic:
        Value: /aruco/robot_pose_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    # Where Gazebo says the robot is (green) and where the global filter puts it (blue): the gap
    # between the two trails is the estimate's error.
    - Class: rviz_default_plugins/Odometry
      Name: Truth
      Enabled: true
      Topic:
        Value: /ground_truth
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 300
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 40; 200; 70
        Alpha: 1
        Shaft Length: 0.25
        Shaft Radius: 0.015
        Head Length: 0.06
        Head Radius: 0.035
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Estimate
      Enabled: true
      Topic:
        Value: /odometry/global
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 300
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 60; 120; 255
        Alpha: 1
        Shaft Length: 0.25
        Shaft Radius: 0.015
        Head Length: 0.06
        Head Radius: 0.035
      Covariance:
        Value: true
        Position:
          Value: true
          Alpha: 0.3
          Color: 60; 120; 255
          Scale: 1
        Orientation:
          Value: false
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      # Best effort, like a sensor: a late scan is dropped.
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 255; 110; 0
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Guard zones
      Enabled: true
      Topic:
        Value: /scan_guard/zones
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Normalize Range: true
      Topic:
        Value: /aruco/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      # Behind and above the robot's start, looking ahead to where the markers are.
      Target Frame: <Fixed Frame>
      Focal Point:
        X: 0.5
        Y: 0
        Z: 0.5
      Distance: 6
      Pitch: 0.5
      Yaw: 3.14
      Near Clip Distance: 0.01
      Value: Orbit (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
  Views:
    collapsed: true
  Camera:
    collapsed: false
